# ==============================================================================
# UEC ESPACE DIGITAL — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# All variables defined in this file are client/browser safe.
# NEVER commit .env.local, service-role keys, or database passwords to Git.
# ==============================================================================

# 1. Supabase Project URL (HTTPS)
# Example: https://aigsdarfiplwmzqtqlxh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Publishable / Anon Key
# Public JWT key with role 'anon' (safe for client-side bundle and browser requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# 3. Application Site URL (for Auth redirects and absolute links)
# Development: http://localhost:3000
# Production: https://espace.uec.tn
NEXT_PUBLIC_SITE_URL=https://espace.uec.tn
